# ==========================================================================
# Lumina 图床 · 环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# 注意：管理台里修改的配置会写入 SQLite 并覆盖本文件中的同名项
# ==========================================================================

# ------------------------------- 服务 -------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
SITE_NAME=Lumina 图床

# 对外可访问的基础地址。反向代理 / 域名访问时务必配置，
# 否则生成的直链会带上容器内部的 host。
# 留空 = 按请求头自动推断
PUBLIC_BASE_URL=

# 置于 Nginx / Caddy / Cloudflare 之后时设为 true，用于取真实 IP 与协议
TRUST_PROXY=false

# Token 有效期（秒），默认 7 天
TOKEN_TTL=604800

# 会话签名密钥。留空会在 data/.secret 自动生成并持久化。
# 多实例部署必须显式配置同一个值。
SESSION_SECRET=

# ------------------------------ 管理员 ------------------------------
# 仅在首次启动（数据库还没有密码哈希）时生效
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# ------------------------------ 上传限额 -----------------------------
# 支持 20mb / 512kb / 1048576 三种写法
MAX_FILE_SIZE=20mb
# 游客单文件上限（可在管理台实时修改）
GUEST_MAX_FILE_SIZE=5mb
# 单次请求最多文件数
MAX_FILES=20
# 是否允许游客上传
GUEST_UPLOAD_ENABLED=true
# 允许的图片格式（逗号分隔）
ALLOWED_FORMATS=jpg,jpeg,png,gif,webp,svg,avif

# ------------------------------ 图像处理 -----------------------------
# 服务端是否对静态位图做再压缩
OPTIMIZE=true
OPTIMIZE_QUALITY=82
# 超过该尺寸的静态图会被等比缩小
MAX_WIDTH=4096
MAX_HEIGHT=4096
THUMBNAIL_WIDTH=480
# SVG 精简（去注释 / 脚本 / 冗余空白）
SVG_MINIFY=true
# SVG 栅格化密度（仅影响缩略图清晰度）
SVG_DENSITY=200
# 相同内容秒传去重
DEDUPE=true

# ------------------------------ 存储驱动 -----------------------------
# local  = 仅本地磁盘
# webdav = 仅远端网盘
# hybrid = 本地 + WebDAV 双写（对外直链走本地，WebDAV 作异地备份）
STORAGE_DRIVER=local
LOCAL_PUBLIC_PREFIX=/i

# WebDAV（Nextcloud / ownCloud / 坚果云 / 群晖 / Alist 等）
# Nextcloud 示例：https://cloud.example.com/remote.php/dav/files/<用户名>
# 坚果云示例：  https://dav.jianguoyun.com/dav
WEBDAV_URL=
WEBDAV_USERNAME=
# 坚果云等平台需使用「应用密码」而非登录密码
WEBDAV_PASSWORD=
WEBDAV_DIRECTORY=lumina
# 对外直链前缀：请填写「已经包含上面这个远端目录」的完整地址，
# 直链 = <该前缀>/<年月/文件名>。留空则退化为 <WEBDAV_URL>/<WEBDAV_DIRECTORY>。
# 私有网盘（需登录才能读）必须配置此项，或指向 Alist 等中转服务的公网地址。
# 示例：https://cdn.example.com/lumina  或  https://cloud.example.com/remote.php/dav/files/user/lumina
WEBDAV_PUBLIC_URL=
WEBDAV_TIMEOUT=30000

# -------------------------------- 路径 --------------------------------
DATA_DIR=data
STORAGE_DIR=storage
DB_PATH=data/lumina.db

# ------------------------------ 安全 / 限流 ------------------------------
# 置 0 可关闭对应限流
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX=60
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_API_MAX=600
# 允许跨域的来源，* 表示全部放开；生产环境建议收敛为具体域名
CORS_ORIGINS=*
